#!/bin/sh
# Runs bin/codex-cache-guard.ts on a Node that strips types: 22.6 or later with
# --experimental-strip-types (on by default from 22.18 and 23.6, where the flag is accepted and
# does nothing). Codex starts hooks with `$SHELL -lc` and the session's environment snapshot, so
# `node` is whatever that shell had first on PATH (an nvm 23.1 here, which has no type stripping
# without the flag); the fallbacks cover a PATH that never saw Homebrew at all.
case "$0" in */*) here=${0%/*} ;; *) here=. ;; esac
here=$(cd "$here" && pwd)
usable() {
    [ -n "$1" ] && [ -x "$1" ] || return 1
    version=$("$1" --version 2>/dev/null) || return 1
    version=${version#v}
    major=${version%%.*}
    rest=${version#*.}
    minor=${rest%%.*}
    [ "$major" -gt 22 ] 2>/dev/null || { [ "$major" -eq 22 ] && [ "$minor" -ge 6 ]; } 2>/dev/null
}
for node in "$(command -v node 2>/dev/null)" /opt/homebrew/bin/node /usr/local/bin/node /usr/bin/node; do
    if usable "$node"; then
        exec "$node" --no-warnings --experimental-strip-types "$here/codex-cache-guard.ts" "$@"
    fi
done
# No usable Node: the hooks fail open (nothing on stdout, exit 0); status says why.
case "$1" in status) echo "codex-cache-guard: no Node 22.6+ found" >&2; exit 1 ;; esac
exit 0
