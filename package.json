{
  "name": "@justmytwospence/codex-cache-guard",
  "version": "0.1.0",
  "description": "Codex hooks that warn before a prompt re-sends a large thread uncached, and a cache status line for tmux.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "bin": {
    "codex-cache-guard": "./bin/codex-cache-guard"
  },
  "keywords": [
    "codex",
    "codex-hooks",
    "prompt-cache"
  ],
  "scripts": {
    "check": "npm run typecheck && npm test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/justmytwospence/codex-cache-guard"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
